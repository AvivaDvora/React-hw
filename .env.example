# העתיקי קובץ זה ל-.env ומלאי ערך אמיתי (הקובץ .env חסום ב-git)
# שימי לב: ב-Vite כל משתנה שמתחיל ב-VITE_ נחשף בקוד ה-build — אין לשים כאן סודות אמיתיים
VITE_AUTH_KEY=your-auth-key-here

# מצב שכבת הנתונים:
#   local → נתונים מקומיים בזיכרון הדפדפן (חלק א' של השיעור)
#   api   → חיבור לשרת Node.js (חלק ב' של השיעור)
VITE_DATA_MODE=local
